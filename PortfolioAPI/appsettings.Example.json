{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": ["http://localhost:4200", "http://localhost:4300"]
  },
  "ConnectionStrings": {
    "Portfolio": "Server=(localdb)\\MSSQLLocalDB;Database=PortfolioLocal;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "RateLimiting": {
    "Contact": { "PermitLimit": 5, "WindowMinutes": 10 },
    "Agent": { "PermitLimit": 20, "WindowSeconds": 60 },
    "ApiRead": { "PermitLimit": 120, "WindowSeconds": 60 }
  }
}
